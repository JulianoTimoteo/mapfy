# ============================================================
# Copie este arquivo para ".env" e preencha. NUNCA versione o .env.
# Valores com "#" ou espaços devem ficar entre aspas: MAPFY_PASS="abc#123"
# ============================================================

# --- Acesso (obrigatório) ---
MAPFY_URL=https://app.mapfy.exemplo/login
MAPFY_USER=seu_usuario
MAPFY_PASS=sua_senha

# --- Navegador ---
HEADLESS=true                 # false = mostra o navegador (depuração)

# --- Navegação até a listagem de relatórios (use UM dos dois) ---
MAPFY_REPORTS_URL=            # URL direta da listagem (preferível)
SEL_REPORTS_MENU=             # ou seletor do menu/link que leva até ela

# --- Seletores da interface (Playwright: CSS, text=..., xpath=...) ---
# Descubra com:  playwright codegen <MAPFY_URL>
SEL_USER=input[name="email"]
SEL_PASS=input[type="password"]
SEL_SUBMIT=button[type="submit"]
SEL_LOGGED_IN=                # elemento visível só após login (recomendado)
SEL_LOGIN_ERROR=              # mensagem de erro de login (evita retentar credencial errada)

SEL_DATE_FROM=                # campo "data inicial" (vazio = sem filtro de datas)
SEL_DATE_TO=                  # campo "data final"
SEL_APPLY_FILTER=             # botão "Filtrar/Buscar" (se existir)
SEL_EXPORT=text=Exportar      # botão que dispara o download CSV/ZIP

# --- Filtro incremental ---
DAYS_BACK=2                   # janela retroativa; sobreposição captura registros editados
DATE_UI_FORMAT=%d/%m/%Y       # formato esperado pelos campos (strftime). ISO: %Y-%m-%d
DATE_INPUT_MODE=fill          # "type" se o campo tiver máscara/datepicker

# --- Dados ---
ID_COLUMN=id                  # nome padronizado (após COLUMN_MAP) da coluna de ID única
CSV_ENCODING=auto             # auto | utf-8 | latin-1
CSV_DELIMITER=auto            # auto | , | ; | tab

# --- Execução ---
INTERVAL_MINUTES=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=15        # backoff exponencial: 15s, 30s, 60s...
TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=180000
KEEP_DOWNLOAD_DAYS=7          # apaga relatorio_* e erro_*.png mais antigos (0 = nunca)

# --- Gateway de relatórios ---
MAPFY_API_HOST=127.0.0.1
MAPFY_API_PORT=8000
MAPFY_API_KEY=                # obrigatória para escutar fora do computador local
MAPFY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500
