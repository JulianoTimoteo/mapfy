# MapFy Telegram Monitor - Configurações

# Identidade do Bot no Telegram
TELEGRAM_BOT_USERNAME=MapfySentinelBot
TELEGRAM_BOT_TOKEN=SUBSTITUIR_PELO_TOKEN_NOVO_DO_BOTFATHER
TELEGRAM_CHAT_ID=OBTER_AUTOMATICAMENTE_OU_CONFIGURAR

# Servidor Local de Notificações (escuta exclusivamente em 127.0.0.1:8765)
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8765
MONITOR_API_KEY=mapfy_monitor_secret_key_2026

# Monitoramento de Execução e Heartbeat
HEARTBEAT_TIMEOUT_SECONDS=180
HEARTBEAT_CHECK_INTERVAL_SECONDS=15
SERVER_NAME=MAPFY-EXTRACTOR
