# ==============================================================================
# MapFy Sentinel v2 — Modelo de Configuração (.env.example)
# COPIE ESTE ARQUIVO PARA .env E PREENCHA SUAS VARIÁVEIS ANTES DE INICIAR.
# NUNCA COLOQUE SENHAS OU TOKENS DE PRODUÇÃO NESTE ARQUIVO MODELO.
# ==============================================================================

# --- Identidade do Bot no Telegram ---
TELEGRAM_BOT_USERNAME=MapfySentinelBot
# Obtenha com o @BotFather no Telegram:
TELEGRAM_BOT_TOKEN=COLE_AQUI_O_TOKEN_GERADO_PELO_BOTFATHER
# CHAT_ID ou ID do grupo autorizado (descubra com /start no bot ou deixe em branco para parear):
TELEGRAM_CHAT_ID=

# Whitelist de Usuários Autorizados no Bot (formato: id:role ou lista de IDs)
# Exemplo: 12345678:admin,87654321:viewer
AUTHORIZED_USERS=

# --- Servidor Local Sentinel (Escuta em 127.0.0.1:8765) ---
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8765
# Chave forte gerada via CLI: python run_server.py --generate-key
MONITOR_API_KEY=GERAR_COM_PYTHON_RUN_SERVER_PY_GENERATE_KEY
# Bloqueio de rede externa por segurança:
ALLOW_REMOTE_BIND=false
ENABLE_API_DOCS=false

# --- Monitoramento Operacional e Resiliência ---
SERVER_NAME=MAPFY-EXTRACTOR
HEARTBEAT_TIMEOUT_SECONDS=180
HEARTBEAT_CHECK_INTERVAL_SECONDS=15

# Observabilidade Avançada e Ponto Cego (Sentinel v2)
# Intervalo programado da extração e tolerância do Dead Man's Switch:
EXPECTED_INTERVAL_MINUTES=60
DEAD_MAN_GRACE_MINUTES=15

# Detecção de travamento de estágio (STALLED) no navegador:
STAGE_STALL_SECONDS=300
MAX_RUN_SECONDS=1800
