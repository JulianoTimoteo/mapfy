[Unit]
Description=MapFy Servidor 24/7 API Gateway e Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Server_MapFy/server
ExecStart=/usr/bin/python3 -u mapfy_server.py
Restart=always
RestartSec=5
KillMode=process
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
