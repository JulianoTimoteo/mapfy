[Unit]
Description=MapFy Telegram Sentinel Monitor 24/7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Server_MapFy/MapFy_Telegram_Monitor
ExecStart=/usr/bin/python3 -u run_server.py
Restart=always
RestartSec=5
KillMode=process
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
